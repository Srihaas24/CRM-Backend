# Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/CRM
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_database_password

# JWT Secret
JWT_SECRET=your_jwt_secret_key_here

# Redis Configuration (Cloud or Local)
SPRING_DATA_REDIS_HOST=son-yard-micromodern-82270.db.redis.io
SPRING_DATA_REDIS_PORT=16362
SPRING_DATA_REDIS_USERNAME=default
SPRING_DATA_REDIS_PASSWORD=your_redis_password

# Application URLs
VERIFICATION_URL=http://localhost:8080/verify
PASSWORD_RESET_URL=http://localhost:8080/reset-password

# Email Service Configuration
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_email_app_password
PORT=8080
